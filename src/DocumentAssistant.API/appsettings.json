{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "DocMindAI",
    "Audience": "DocMindAI",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "OpenAI": {
    "ApiKey": "",
    "ChatModel": "gpt-4o",
    "EmbeddingModel": "text-embedding-3-small"
  },
  "Authentication": {
    "Google": {
      "ClientId": ""
    }
  },
  "Qdrant": {
    "Host": "localhost",
    "GrpcPort": 6334,
    "UseHttps": false,
    "ApiKey": "",
    "CollectionName": "document_chunks",
    "VectorSize": 1536
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Storage": {
    "RootPath": "storage"
  },
  "RunMigrationsOnStartup": true,
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"]
  }
}
